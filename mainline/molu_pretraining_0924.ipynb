   "source": [
    "\n",
    "def stream_labeled_sequences(shuffle=False, seed=None):\n",
    "    base_seed = SEED if seed is None else seed\n",
    "    mono_seed = base_seed + 1 if shuffle else None\n",
    "    pair_seed = base_seed + 2 if shuffle else None\n",
    "\n",
    "    for doc in iter_mono_docs(shuffle=shuffle, seed=mono_seed):\n",
    "        doc_ids = [BOS] + encode_text(doc) + [EOS]\n",
    "        if len(doc_ids) >= 2:\n",
    "            yield doc_ids, doc_ids\n",
    "\n",
    "    for ctx, rsp in iter_pairs(shuffle=shuffle, seed=pair_seed):\n",
    "        ctx_ids = [BOS] + encode_text(ctx) + [SEP]\n",
    "        rsp_ids = encode_text(rsp) + [EOS]\n",
    "        if rsp_ids:\n",
    "            input_ids = ctx_ids + rsp_ids\n",
    "            labels = [-100] * len(ctx_ids) + rsp_ids\n",
    "            yield input_ids, labels\n",
    "\n",
    "def iter_packed_sequences(sequence_iter, max_length, pad_id):\n",
    "    buffer_tokens, buffer_labels = [], []\n",
    "    for tokens, labels in sequence_iter:\n",
    "        pos = 0\n",
    "        while pos < len(tokens):\n",
    "            remaining = max_length - len(buffer_tokens)\n",
    "            take = min(remaining, len(tokens) - pos)\n",
    "            if take:\n",
    "                buffer_tokens.extend(tokens[pos:pos + take])\n",
    "                buffer_labels.extend(labels[pos:pos + take])\n",
    "                pos += take\n",
    "            if len(buffer_tokens) == max_length:\n",
    "                attn = [1] * max_length\n",
    "                yield buffer_tokens, buffer_labels, attn\n",
    "                buffer_tokens, buffer_labels = [], []\n",
    "    if buffer_tokens:\n",
    "        pad_len = max_length - len(buffer_tokens)\n",
    "        attn = [1] * len(buffer_tokens) + [0] * pad_len\n",
    "        yield (\n",
    "            buffer_tokens + [pad_id] * pad_len,\n",
    "            buffer_labels + [-100] * pad_len,\n",
    "            attn,\n",
    "        )\n",
    "\n",
    "def summarize_packed_sequences():\n",
    "    first_chunk = None\n",
    "    total_tokens = 0\n",
    "    total_chunks = 0\n",
    "    for tokens, labels, attn in iter_packed_sequences(stream_labeled_sequences(shuffle=False), MAX_LEN, PAD):\n",
    "        if first_chunk is None:\n",
    "            first_chunk = (tokens[:], labels[:], attn[:])\n",
    "        total_tokens += sum(attn)\n",
    "        total_chunks += 1\n",
    "    return first_chunk, total_tokens, total_chunks\n",
    "\n",
    "summary_chunk, TOK_PER_EPOCH, PACKED_CHUNKS = summarize_packed_sequences()\n",
    "USE_DIALOGUE_PROMPT = DATA_STATS[\"pair_count\"] > 0\n",
    "\n",
    "print(f\"Packed chunks: {PACKED_CHUNKS}\")\n",
    "print(f\"Tokens per epoch: {TOK_PER_EPOCH}\")\n",
    "if summary_chunk is not None:\n",
    "    tokens_sample, labels_sample, attn_sample = summary_chunk\n",
    "    preview = min(len(tokens_sample), 32)\n",
    "    print(\"Sample packed input:\", tokens_sample[:preview])\n",
    "    print(\"Sample packed labels:\", labels_sample[:preview])\n",
    "    print(\"Sample attention:\", attn_sample[:preview])\n",
    "else:\n",
    "    print(\"No packed sequences were produced.\")\n"
   ]
