      "source": [
        "# === \ud14d\uc2a4\ud2b8 \ub370\uc774\ud130 \uc0dd\uc131 ===\n",
        "ZIP_PATH = \"/content/drive/MyDrive/Data/Dataset/Pretraining.zip\"   # \uacbd\ub85c\n",
        "import zipfile, json, io, re, random\n",
        "from pathlib import Path\n",
        "\n",
        "# \uc635\uc158\n",
        "PAIRING_MODE = \"turn_change\"\n",
        "TEXT_FIELD = \"form\"             # or \"original_form\"\n",
        "MIN_TEXT_CHARS = 5              # \ubb38\uc7a5 \ud544\ud130\n",
        "MAX_TEXT_CHARS = 4000\n",
        "MAX_LEN = 160                   # \ud1a0\ud06c\ub098\uc774\uc800 \ubc0f \ud559\uc2b5 \uc2dc\ud000\uc2a4 \uae38\uc774\n",
        "SHUFFLE = True\n",
        "SEED = 42\n",
        "SHUFFLE_BUFFER_SIZE = 8192\n",
        "VAL_SPLIT_MOD = 5               # roughly 80/20 split for train/val\n",
        "VAL_SPLIT_BUCKET = 0\n",
        "\n",
        "TEXT_FALLBACK_KEYS = (\"text\", \"content\", \"body\", \"article\", \"paragraphs\", \"summary\")\n",
        "\n",
        "OUTPUT_DIR = Path(\"preprocessed\")\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "MONO_PATH = OUTPUT_DIR / \"mono_docs.txt\"\n",
        "PAIR_PATH = OUTPUT_DIR / \"pairs.jsonl\"\n",
        "STATS_PATH = OUTPUT_DIR / \"stats.json\"\n",
        "\n",
        "def clean_text(text: str) -> str:\n",
        "    text = text.replace(\"\u200b\", \"\").strip()\n",
        "    text = re.sub(r\"\\s+\", \" \", text)\n",
        "    return text\n",
        "\n",
        "def is_korean(text: str) -> bool:\n",
        "    kor = len(re.findall(r\"[\uac00-\ud7a3]\", text))\n",
        "    return kor >= max(2, int(0.2 * len(text)))\n",
        "\n",
        "def iter_conversation_docs(payload):\n",
        "    if isinstance(payload, dict):\n",
        "        docs = payload.get(\"document\")\n",
        "        if isinstance(docs, list):\n",
        "            for doc in docs:\n",
        "                if isinstance(doc, dict) and isinstance(doc.get(\"utterance\"), list):\n",
        "                    yield doc\n",
        "    elif isinstance(payload, list):\n",
        "        for item in payload:\n",
        "            yield from iter_conversation_docs(item)\n",
        "\n",
        "def iter_strings(value):\n",
        "    if isinstance(value, str):\n",
        "        cleaned = clean_text(value)\n",
        "        if cleaned:\n",
        "            yield cleaned\n",
        "    elif isinstance(value, list):\n",
        "        for item in value:\n",
        "            yield from iter_strings(item)\n",
        "    elif isinstance(value, dict):\n",
        "        for inner in value.values():\n",
        "            yield from iter_strings(inner)\n",
        "\n",
        "def extract_prose_texts(payload):\n",
        "    if isinstance(payload, dict):\n",
        "        for key, value in payload.items():\n",
        "            if key in TEXT_FALLBACK_KEYS:\n",
        "                yield from iter_strings(value)\n",
        "            else:\n",
        "                yield from extract_prose_texts(value)\n",
        "    elif isinstance(payload, list):\n",
        "        for item in payload:\n",
        "            yield from extract_prose_texts(item)\n",
        "    elif isinstance(payload, str):\n",
        "        cleaned = clean_text(payload)\n",
        "        if cleaned:\n",
        "            yield cleaned\n",
        "\n",
        "mono_count = pair_count = 0\n",
        "n_files = 0\n",
        "missing_speaker_docs = 0\n",
        "first_mono = None\n",
        "first_pair = None\n",
        "\n",
        "with open(MONO_PATH, \"w\", encoding=\"utf-8\") as mono_out, open(PAIR_PATH, \"w\", encoding=\"utf-8\") as pair_out:\n",
        "    with zipfile.ZipFile(ZIP_PATH) as zf:\n",
        "        for name in zf.namelist():\n",
        "            if not name.lower().endswith(\".json\"):\n",
        "                continue\n",
        "            n_files += 1\n",
        "            with zf.open(name) as f:\n",
        "                data = json.load(io.TextIOWrapper(f, encoding=\"utf-8-sig\"))\n",
        "\n",
        "            has_conversation = False\n",
        "            for doc in iter_conversation_docs(data):\n",
        "                has_conversation = True\n",
        "                utts = doc.get(\"utterance\", [])\n",
        "                if not isinstance(utts, list):\n",
        "                    continue\n",
        "                utts = sorted(\n",
        "                    (utt for utt in utts if isinstance(utt, dict)),\n",
        "                    key=lambda u: (u.get(\"start\", float(\"inf\")), u.get(\"id\", \"\")),\n",
        "                )\n",
        "\n",
        "                cleaned_turns = []\n",
        "                for utt in utts:\n",
        "                    if TEXT_FIELD == \"form\":\n",
        "                        preferred = utt.get(\"form\")\n",
        "                    elif TEXT_FIELD == \"original_form\":\n",
        "                        preferred = utt.get(\"original_form\")\n",
        "                    else:\n",
        "                        raise ValueError(\"TEXT_FIELD must be 'form' or 'original_form'\")\n",
        "\n",
        "                    raw = preferred or utt.get(\"form\") or utt.get(\"original_form\") or \"\"\n",
        "                    text = clean_text(raw)\n",
        "                    if not text:\n",
        "                        continue\n",
        "                    if not is_korean(text):\n",
        "                        continue\n",
        "                    if len(text) > MAX_TEXT_CHARS:\n",
        "                        continue\n",
        "\n",
        "                    speaker = utt.get(\"speaker_id\")\n",
        "                    if speaker is not None:\n",
        "                        speaker = str(speaker).strip() or None\n",
        "                    cleaned_turns.append((text, speaker))\n",
        "\n",
        "                if not cleaned_turns:\n",
        "                    continue\n",
        "\n",
        "                doc_text = clean_text(\" \".join(text for text, _ in cleaned_turns))\n",
        "                if doc_text and MIN_TEXT_CHARS <= len(doc_text) <= MAX_TEXT_CHARS and is_korean(doc_text):\n",
        "                    mono_out.write(doc_text + \"\\n\")\n",
        "                    mono_count += 1\n",
        "                    if first_mono is None:\n",
        "                        first_mono = doc_text\n",
        "\n",
        "                has_speaker_annotations = any(speaker is not None for _, speaker in cleaned_turns)\n",
        "                if not has_speaker_annotations:\n",
        "                    continue\n",
        "\n",
        "                if any(speaker is None for _, speaker in cleaned_turns):\n",
        "                    missing_speaker_docs += 1\n",
        "                    continue\n",
        "\n",
        "                sequence = []\n",
        "                current_speaker = None\n",
        "                buffer = []\n",
        "\n",
        "                def flush_buffer(speaker_id):\n",
        "                    if not buffer:\n",
        "                        return\n",
        "                    combined = clean_text(\" \".join(buffer))\n",
        "                    buffer.clear()\n",
        "                    if not combined:\n",
        "                        return\n",
        "                    if len(combined) < MIN_TEXT_CHARS or len(combined) > MAX_TEXT_CHARS:\n",
        "                        return\n",
        "                    if not is_korean(combined):\n",
        "                        return\n",
        "                    sequence.append((combined, speaker_id))\n",
        "\n",
        "                for text, speaker in cleaned_turns:\n",
        "                    if current_speaker is None:\n",
        "                        current_speaker = speaker\n",
        "                        buffer.append(text)\n",
        "                        continue\n",
        "\n",
        "                    if speaker == current_speaker:\n",
        "                        buffer.append(text)\n",
        "                    else:\n",
        "                        flush_buffer(current_speaker)\n",
        "                        current_speaker = speaker\n",
        "                        buffer.append(text)\n",
        "\n",
        "                flush_buffer(current_speaker)\n",
        "\n",
        "                if len(sequence) < 2:\n",
        "                    continue\n",
        "\n",
        "                speakers = {speaker for _, speaker in sequence if speaker is not None}\n",
        "                if len(speakers) < 2:\n",
        "                    continue\n",
        "\n",
        "                if PAIRING_MODE == \"turn_change\":\n",
        "                    iterator = ((a, b) for (a, spk_a), (b, spk_b) in zip(sequence, sequence[1:]) if spk_a != spk_b and a and b)\n",
        "                else:\n",
        "                    iterator = ((a, b) for (a, _), (b, _) in zip(sequence, sequence[1:]) if a and b)\n",
        "\n",
        "                for ctx, rsp in iterator:\n",
        "                    pair_out.write(json.dumps({\"ctx\": ctx, \"rsp\": rsp}, ensure_ascii=False) + \"\\n\")\n",
        "                    pair_count += 1\n",
        "                    if first_pair is None:\n",
        "                        first_pair = (ctx, rsp)\n",
        "\n",
        "            if has_conversation:\n",
        "                continue\n",
        "\n",
        "            for text in extract_prose_texts(data):\n",
        "                if len(text) < MIN_TEXT_CHARS or len(text) > MAX_TEXT_CHARS:\n",
        "                    continue\n",
        "                if not is_korean(text):\n",
        "                    continue\n",
        "                mono_out.write(text + \"\\n\")\n",
        "                mono_count += 1\n",
        "                if first_mono is None:\n",
        "                    first_mono = text\n",
        "\n",
        "DATA_STATS = {\n",
        "    \"files\": n_files,\n",
        "    \"mono_count\": mono_count,\n",
        "    \"pair_count\": pair_count,\n",
        "    \"missing_speaker_docs\": missing_speaker_docs,\n",
        "}\n",
        "with open(STATS_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(DATA_STATS, f, ensure_ascii=False, indent=2)\n",
        "\n",
        "print(f\"JSON files read: {n_files}\")\n",
        "print(f\"Total documents: {mono_count}\")\n",
        "if mono_count and first_mono:\n",
        "    snippet = first_mono[:200] + (\"...\" if len(first_mono) > 200 else \"\")\n",
        "    print(\"Sample document:\", snippet)\n",
        "if missing_speaker_docs and pair_count == 0:\n",
        "    print(f\"Documents without speaker metadata: {missing_speaker_docs}\")\n",
        "print(f\"Total pairs: {pair_count}\")\n",
        "if pair_count and first_pair:\n",
        "    print(\"Sample pair:\", first_pair)\n",
        "else:\n",
        "    print(\"Sample pair: (<empty>, <empty>)\")\n",
        "\n",
        "def stream_with_optional_shuffle(iterator, shuffle=False, buffer_size=8192, seed=None):\n",
        "    if not shuffle:\n",
        "        for item in iterator:\n",
        "            yield item\n",
        "        return\n",
        "    rng = random.Random(SEED if seed is None else seed)\n",
        "    buffer = []\n",
        "    flush_threshold = max(1, buffer_size // 2)\n",
        "    for item in iterator:\n",
        "        buffer.append(item)\n",
        "        if len(buffer) >= buffer_size:\n",
        "            rng.shuffle(buffer)\n",
        "            while len(buffer) > flush_threshold:\n",
        "                yield buffer.pop()\n",
        "    if buffer:\n",
        "        rng.shuffle(buffer)\n",
        "        while buffer:\n",
        "            yield buffer.pop()\n",
        "\n",
        "def iter_mono_docs(shuffle=False, seed=None):\n",
        "    if not MONO_PATH.exists():\n",
        "        return iter(())\n",
        "    def base_iter():\n",
        "        with open(MONO_PATH, encoding=\"utf-8\") as f:\n",
        "            for line in f:\n",
        "                text = line.rstrip(\"\\n\")\n",
        "                if text:\n",
        "                    yield text\n",
        "    return stream_with_optional_shuffle(base_iter(), shuffle=shuffle, buffer_size=SHUFFLE_BUFFER_SIZE, seed=seed)\n",
        "\n",
        "def iter_pairs(shuffle=False, seed=None):\n",
        "    if not PAIR_PATH.exists():\n",
        "        return iter(())\n",
        "    def base_iter():\n",
        "        with open(PAIR_PATH, encoding=\"utf-8\") as f:\n",
        "            for line in f:\n",
        "                record = line.strip()\n",
        "                if not record:\n",
        "                    continue\n",
        "                payload = json.loads(record)\n",
        "                ctx = clean_text(payload.get(\"ctx\", \"\"))\n",
        "                rsp = clean_text(payload.get(\"rsp\", \"\"))\n",
        "                if ctx and rsp:\n",
        "                    yield ctx, rsp\n",
        "    return stream_with_optional_shuffle(base_iter(), shuffle=shuffle, buffer_size=SHUFFLE_BUFFER_SIZE, seed=seed)\n"
      ]
    },
    {
