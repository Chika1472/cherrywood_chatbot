    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "dwQpRSpnBl0Y"
      },
      "outputs": [],
      "source": [
        "import torch, torch.nn.functional as F, time, json, os, hashlib\n",
        "from array import array\n",
        "from torch.utils.data import IterableDataset, DataLoader\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "model = GPTScratch(\n",
        "    vocab_size=VOCAB_SIZE,\n",
        "    d_model=512, n_layers=8, n_heads=8,\n",
        "    max_len=MAX_LEN, dropout=0.1\n",
        ").to(device)\n",
        "\n",
        "optimizer = torch.optim.AdamW(model.parameters(), lr=3e-4, weight_decay=0.01, betas=(0.9, 0.95))\n",
        "scaler = torch.amp.GradScaler('cuda', enabled=torch.cuda.is_available())\n",
        "\n",
        "def lm_loss(logits, targets):\n",
        "    vocab = logits.size(-1)\n",
        "    pred = logits[:, :-1].contiguous().view(-1, vocab)\n",
        "    gold = targets[:, 1:].contiguous().view(-1)\n",
        "    return F.cross_entropy(pred, gold, ignore_index=-100)\n",
        "\n",
        "def compute_bucket(tokens, modulus=VAL_SPLIT_MOD):\n",
        "    buf = array('I', tokens).tobytes()\n",
        "    digest = hashlib.blake2b(buf, digest_size=8).digest()\n",
        "    return int.from_bytes(digest, 'little') % modulus\n",
        "\n",
        "class PackedIterableDataset(IterableDataset):\n",
        "    def __init__(self, split=\"train\", shuffle=False, base_seed=SEED):\n",
        "        self.split = split\n",
        "        self.shuffle = shuffle\n",
        "        self.base_seed = base_seed\n",
        "        self.epoch = 0\n",
        "\n",
        "    def set_epoch(self, epoch):\n",
        "        self.epoch = epoch\n",
        "\n",
        "    def _belongs_to_split(self, tokens):\n",
        "        bucket = compute_bucket(tokens)\n",
        "        if self.split == \"val\":\n",
        "            return bucket == VAL_SPLIT_BUCKET\n",
        "        if self.split == \"train\":\n",
        "            return bucket != VAL_SPLIT_BUCKET\n",
        "        return True\n",
        "\n",
        "    def __iter__(self):\n",
        "        seed = self.base_seed + self.epoch if self.shuffle else None\n",
        "        sequence_iter = stream_labeled_sequences(shuffle=self.shuffle, seed=seed)\n",
        "        for tokens, labels, attn in iter_packed_sequences(sequence_iter, MAX_LEN, PAD):\n",
        "            if not self._belongs_to_split(tokens):\n",
        "                continue\n",
        "            yield {\n",
        "                \"input_ids\": torch.tensor(tokens, dtype=torch.long),\n",
        "                \"labels\": torch.tensor(labels, dtype=torch.long),\n",
        "                \"attention_mask\": torch.tensor(attn, dtype=torch.long),\n",
        "            }\n",
        "\n",
        "@torch.no_grad()\n",
        "def evaluate():\n",
        "    model.eval()\n",
        "    total, n = 0.0, 0\n",
        "    val_dataset.set_epoch(0)\n",
        "    for batch in val_dl:\n",
        "        x = batch[\"input_ids\"].to(device)\n",
        "        y = batch[\"labels\"].to(device)\n",
        "        attn = batch[\"attention_mask\"].to(device)\n",
        "        with torch.amp.autocast('cuda', enabled=torch.cuda.is_available()):\n",
        "            loss = lm_loss(model(x, attention_mask=attn), y)\n",
        "        total += loss.item()\n",
        "        n += 1\n",
        "    return total / max(1, n)\n",
        "\n",
        "EPOCHS, ACCUM = 20, 4\n",
        "best = float(\"inf\")\n",
        "save_dir = \"molu_chatbot\"\n",
        "\n",
        "BATCH_SIZE = 32\n",
        "\n",
        "train_dataset = PackedIterableDataset(split=\"train\", shuffle=SHUFFLE, base_seed=SEED)\n",
        "val_dataset = PackedIterableDataset(split=\"val\", shuffle=False, base_seed=SEED)\n",
        "\n",
        "train_dl = DataLoader(train_dataset, batch_size=BATCH_SIZE)\n",
        "val_dl = DataLoader(val_dataset, batch_size=BATCH_SIZE)\n",
        "\n",
        "for ep in range(1, EPOCHS + 1):\n",
        "    model.train()\n",
        "    train_dataset.set_epoch(ep)\n",
        "    t0 = time.time()\n",
        "    optimizer.zero_grad(set_to_none=True)\n",
        "    step = 0\n",
        "    for i, batch in enumerate(train_dl, 1):\n",
        "        x = batch[\"input_ids\"].to(device)\n",
        "        y = batch[\"labels\"].to(device)\n",
        "        attn = batch[\"attention_mask\"].to(device)\n",
        "        with torch.amp.autocast('cuda', enabled=torch.cuda.is_available()):\n",
        "            loss = lm_loss(model(x, attention_mask=attn), y) / ACCUM\n",
        "        scaler.scale(loss).backward()\n",
        "        if i % ACCUM == 0:\n",
        "            scaler.unscale_(optimizer)\n",
        "            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
        "            scaler.step(optimizer)\n",
        "            scaler.update()\n",
        "            optimizer.zero_grad(set_to_none=True)\n",
        "            step += 1\n",
        "            if step % 100 == 0:\n",
        "                print(f\"step {step} | loss {(loss.item() * ACCUM):.4f}\")\n",
        "\n",
        "    val_loss = evaluate()\n",
        "    print(f\"[epoch {ep}] val_loss={val_loss:.4f} | {(time.time() - t0) / 60:.1f} min\")\n",
        "    if val_loss < best:\n",
        "        best = val_loss\n",
        "        os.makedirs(save_dir, exist_ok=True)\n",
        "        torch.save(model.state_dict(), f\"{save_dir}/model.pt\")\n",
        "        with open(f\"{save_dir}/config.json\", \"w\") as f:\n",
        "            json.dump({\n",
        "                \"vocab_size\": VOCAB_SIZE, \"d_model\": 512, \"n_layers\": 8, \"n_heads\": 8,\n",
        "                \"max_len\": MAX_LEN, \"dropout\": 0.1,\n",
        "                \"special_tokens\": {\"PAD\": PAD, \"BOS\": BOS, \"SEP\": SEP, \"EOS\": EOS}\n",
        "            }, f, indent=2)\n",
        "        print(\"SAVED:\", save_dir)\n"
      ]
    },
